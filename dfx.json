{
    "canisters": {
        "internet_identity": {
            "type": "pull",
            "id": "rdmx6-jaaaa-aaaaa-aaadq-cai"
        },
        "backend": {
            "type": "motoko",
            "main": "backend/Backend.mo",
            "declarations": {
                "node_compatibility": true
            }
        },
        "user_profile": {
            "dependencies": ["internet_identity"],
            "type": "motoko",
            "main": "backend/UserProfile.mo",
            "declarations": {
                "node_compatibility": true
            }
        },
        "frontend": {
            "dependencies": ["backend"],
            "type": "assets",
            "source": ["dist/"]
        }
    },
    "defaults": {
        "build": {
            "packtool": "npm run --silent sources"
        }
    },
    "output_env_file": ".env",
    "version": 2
}
